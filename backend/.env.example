# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/complaint_review?schema=public

# Authentication & JWT
JWT_ACCESS_SECRET=complaint_review_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=complaint_review_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=complaint_review_cookie_secret_change_in_production
